{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Printer": {
    "Type": "serial",
    "Port": "COM3",
    "Baud": 9600,
    "NetworkHost": "printer.local"
  },
  "Briefing": {
    "ScheduledHour": 7,
    "ScheduledMinute": 0
  }
}
